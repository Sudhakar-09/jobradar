# Local development defaults only. Keep real credentials in the ignored .env file.
APP_NAME=JobRadar
ENVIRONMENT=development
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://jobradar:local_dev_only@localhost:5432/jobradar
REDIS_HOST=localhost
HEALTH_CHECK_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO