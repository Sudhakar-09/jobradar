# Local development defaults only. Keep real credentials in the ignored .env file.
APP_NAME=JobRadar
ENVIRONMENT=development
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://jobradar:local_dev_only@localhost:5432/jobradar
REDIS_HOST=localhost
HEALTH_CHECK_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
CONFIG_DIR=config
PACKS_DIR=packs
# Database timeouts
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_APP_ROLE=jobradar_app
DB_CORPUS_ROLE=jobradar_corpus

# Outbound HTTP (all connectors go through core.http)
HTTP_USER_AGENT=JobRadar/0.1
# Optional: an email address or URL where site owners can reach you; appended to the User-Agent.
HTTP_CONTACT=
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_TOTAL_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=4
HTTP_MAX_REDIRECTS=3
HTTP_MAX_RESPONSE_BYTES=10000000
HTTP_RETRY_AFTER_CAP_SECONDS=60
